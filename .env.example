# Required in production
APP_ENV=production
KV_REST_API_URL=
KV_REST_API_TOKEN=
CRON_SECRET=

# Wise ID OIDC. Secrets belong in Vercel/local env only; never expose them as
# VITE_* variables because Vite embeds those values into the browser bundle.
WISE_AUTH_ISSUER=https://wise-invest.org
WISE_AUTH_CLIENT_ID=wise_etf
WISE_AUTH_CLIENT_SECRET=
WISE_AUTH_SCOPE=openid profile email wise.membership
WISE_AUTH_SESSION_TTL=2592000

# Optional overrides. Production defaults to wise-etf.com; local development
# derives the callback from the request. Set only for a different canonical host.
# WISE_AUTH_REDIRECT_URI=https://www.wise-etf.com/api/auth/callback/wise
# WISE_AUTH_SESSION_SECRET=
# Local callback registered in Wise Invest SSO admin:
# WISE_AUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback/wise

# Optional integrations
DEEPSEEK_API_KEY=
WX_APPID=
WX_SECRET=

# Comma-separated browser origins. Same-origin clients do not require CORS.
CORS_ORIGINS=https://wise-etf.com,https://www.wise-etf.com

# Local-only escape hatch for manually calling cron/admin routes without a secret.
# Prefer setting APP_ENV=development; never enable this in production.
ALLOW_INSECURE_LOCAL_JOBS=0
PROVIDER_MAX_CONCURRENCY=12

# Frontend UI convenience only; never a security boundary. It is honored only
# by the Vite dev server on a loopback browser address.
VITE_LOCAL_AUTH_BYPASS=false

# QDII defaults to the internal-test password gate. Set true only after final
# production acceptance to remove the gate; this does not relax cron auth.
VITE_QDII_ENABLED=false
