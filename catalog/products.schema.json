{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wise-etf.com/schemas/products.v1.json",
  "title": "WiseETF Product Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "catalog_version",
    "metadata_as_of",
    "source",
    "merge_policy",
    "metadata",
    "products"
  ],
  "properties": {
    "$schema": { "const": "./products.schema.json" },
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "metadata_as_of": { "$ref": "#/$defs/date" },
    "source": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "merge_policy": { "const": "backend_preferred_frontend_union" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_diff", "units"],
      "properties": {
        "source_diff": { "type": "object" },
        "units": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[0-9]{6}$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "finiteNumberOrNull": { "type": ["number", "null"] },
    "stringOrNull": { "type": ["string", "null"] },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annual_return_2025",
        "scale",
        "fee",
        "track_error",
        "daily_limit",
        "subscription_status",
        "premium",
        "volume",
        "change_pct",
        "market_price",
        "nav"
      ],
      "properties": {
        "annual_return_2025": { "$ref": "#/$defs/finiteNumberOrNull" },
        "annual_return_2025_as_of": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "scale": { "$ref": "#/$defs/finiteNumberOrNull" },
        "scale_as_of": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "fee": { "$ref": "#/$defs/finiteNumberOrNull" },
        "track_error": { "$ref": "#/$defs/finiteNumberOrNull" },
        "track_error_as_of": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "metadata_fetched_at": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "daily_limit": { "$ref": "#/$defs/stringOrNull" },
        "subscription_status": {
          "enum": ["open", "limited", "suspended", "unknown", null]
        },
        "premium": { "$ref": "#/$defs/finiteNumberOrNull" },
        "volume": { "$ref": "#/$defs/finiteNumberOrNull" },
        "change_pct": { "$ref": "#/$defs/finiteNumberOrNull" },
        "market_price": { "$ref": "#/$defs/finiteNumberOrNull" },
        "nav": { "$ref": "#/$defs/finiteNumberOrNull" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "product_type",
        "categories",
        "share_class",
        "master_code",
        "related_share_codes",
        "tracking_index",
        "static_snapshot",
        "metadata_as_of",
        "source"
      ],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "name": { "type": "string", "minLength": 1 },
        "product_type": { "enum": ["fund", "etf"] },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["nasdaq_passive", "sp500_passive", "us_active", "etfs"] }
        },
        "share_class": { "enum": ["A", "C", "unspecified"] },
        "master_code": { "oneOf": [{ "$ref": "#/$defs/code" }, { "type": "null" }] },
        "related_share_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/code" }
        },
        "tracking_index": { "$ref": "#/$defs/stringOrNull" },
        "static_snapshot": { "$ref": "#/$defs/snapshot" },
        "metadata_as_of": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "source": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
